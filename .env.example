# Cấu hình biến môi trường cho Model AI Thứ 2 - KDV (Kiểm Duyệt Viên)
# Tạo bản sao file này thành .env và điền key thực tế vào
KDV_API_KEY=your_kdv_api_key_here
KDV_BASE_URL=https://api.xah.io/v1
KDV_MODEL=gpt-5.4
VISION_MODEL=daongocson12022004/gemini-3.8-flash-high
REPORT_MODEL=dungcsnd113/qwen3.8-omni-flash
# Enable only after verifying CKEY image-input/chat contract and request limits.
CKEY_CHAT_CONTRACT_VERIFIED=0
CKEY_REPORT_CONTRACT_VERIFIED=0
CKEY_MAX_IMAGES_PER_REQUEST=1
CKEY_MAX_OUTPUT_TOKENS=4096
